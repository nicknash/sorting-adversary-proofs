import SortingAdversary.Optimal.LedgerStoredReplay
import SortingAdversary.Optimal.StoredRouting

/-!
# Actual local histories at immutable stored node identities

`LocalEvolution` is generated by the concrete operations performed by the
controller: a repair step, an admission, or a public comparison insertion.
`Evolves` transports every pre-existing node occurrence to the same immutable
identity with such a history. It does not assert any pricing or entropy bound.
-/

namespace SortingAdversary.Optimal.StoredEvolution

open PoolState WidthRepair PoolTree.Tree LedgerStoredReplay

variable {n : ℕ}

def ofData (p : Pool n) (d : LocalData p) : State n := ⟨p, d.rows, d.order⟩

inductive LocalEvolution : State n → State n → Prop
  | refl (s : State n) : LocalEvolution s s
  | step {s t : State n} (operation : Step s t) : LocalEvolution s t
  | admission (p : Pool n) (d : LocalData p) (v : Fin n) (hv : v ∉ p.members) :
      LocalEvolution (ofData p d) (ofData (p.admission v hv).next (d.admission p v hv))
  | comparison (p : Pool n) (d : LocalData p) (a b : Fin n)
      (ha : a ∈ p.members) (hb : b ∈ p.members) (hne : a ≠ b)
      (hi : ControllerRouting.Invariant (Safety.closedAdd p.system a b) p.pins) :
      LocalEvolution (ofData p d)
        (ofData (addComparison p a b ha hb hi) (d.add p a b ha hb hne hi))
  | trans {s t u : State n} : LocalEvolution s t → LocalEvolution t u → LocalEvolution s u

inductive NodeAt : StoredTree n → ℕ → State n → Prop
  | here (identity : ℕ) (p : Pool n) (d : LocalData p) (children : List (ℕ × StoredTree n)) :
      NodeAt (.node identity p d children) identity (ofData p d)
  | descendant {identity : ℕ} {p : Pool n} {d : LocalData p} {children : List (ℕ × StoredTree n)}
      (child : ℕ × StoredTree n) (member : child ∈ children) {target : ℕ} {state : State n}
      (occurs : NodeAt child.2 target state) : NodeAt (.node identity p d children) target state

def Evolves (before after : StoredTree n) : Prop :=
  ∀ identity state, NodeAt before identity state →
    ∃ next, NodeAt after identity next ∧ LocalEvolution state next

theorem Evolves.refl (tree : StoredTree n) : Evolves tree tree :=
  fun _ state occurs => ⟨state, occurs, .refl state⟩

theorem Evolves.trans {first middle last : StoredTree n}
    (h₁ : Evolves first middle) (h₂ : Evolves middle last) : Evolves first last := by
  intro identity state occurs
  obtain ⟨mid, hm, he⟩ := h₁ identity state occurs
  obtain ⟨final, hf, he'⟩ := h₂ identity mid hm
  exact ⟨final, hf, he.trans he'⟩

theorem Evolves.node (identity : ℕ) (p q : Pool n) (d : LocalData p) (e : LocalData q)
    (before after : List (ℕ × StoredTree n)) (root : LocalEvolution (ofData p d) (ofData q e))
    (children : ∀ a ∈ before, ∃ b ∈ after, Evolves a.2 b.2) :
    Evolves (.node identity p d before) (.node identity q e after) := by
  intro target state occurs
  cases occurs with
  | here => exact ⟨ofData q e, .here identity q e after, root⟩
  | descendant a ha hn =>
    obtain ⟨b, hb, he⟩ := children a ha
    obtain ⟨next, hnext, history⟩ := he target state hn
    exact ⟨next, .descendant b hb hnext, history⟩

theorem Evolves.poolUpdate (identity : ℕ) (p q : Pool n) (d : LocalData p) (e : LocalData q)
    (children : List (ℕ × StoredTree n)) (root : LocalEvolution (ofData p d) (ofData q e)) :
    Evolves (.node identity p d children) (.node identity q e children) :=
  Evolves.node identity p q d e children children root
    (fun a ha => ⟨a, ha, Evolves.refl a.2⟩)

theorem Evolves.admitRoot (tree : StoredTree n) (v : Fin n) (hv : v ∉ tree.pool.members) :
    Evolves tree (tree.admitRoot v hv) := by
  cases tree with
  | node identity p d children =>
    rw [StoredTree.admitRoot]
    apply Evolves.node identity p _ d _ children _ (.admission p d v hv)
    intro a ha
    refine ⟨(ColourTransport.extend (p.admission v hv).embed a.1, a.2), ?_, Evolves.refl a.2⟩
    exact List.mem_map.mpr ⟨a, ha, rfl⟩

theorem Evolves.promotedChild {p : Pool n} {children : List (ℕ × StoredTree n)}
    (h : Parts p (StoredTree.erasedChildren children)) (v : Fin n) (hv : p.pins v = none)
    (c : Fin (p.palette + 1)) (r : Promotion.Result p.system p.pins v c)
    (a : ℕ × StoredTree n) (ha : a ∈ children) :
    Evolves a.2 (StoredTree.promotedChild h v hv c r a ha) := by
  unfold StoredTree.promotedChild
  split
  · exact Evolves.admitRoot a.2 v _
  · exact Evolves.refl a.2

theorem evolves_promotedChildren {p : Pool n} {children : List (ℕ × StoredTree n)}
    (h : Parts p (StoredTree.erasedChildren children)) (v : Fin n) (hv : p.pins v = none)
    (c : Fin (p.palette + 1)) (r : Promotion.Result p.system p.pins v c) :
    ∀ a ∈ children, ∃ b ∈ StoredTree.promotedChildren h v hv c r, Evolves a.2 b.2 := by
  intro a ha
  refine ⟨(ColourTransport.extend r.embed a.1, StoredTree.promotedChild h v hv c r a ha), ?_,
    Evolves.promotedChild h v hv c r a ha⟩
  exact List.mem_map.mpr ⟨⟨a, ha⟩, List.mem_attach _ _, rfl⟩

theorem Evolves.promotedNode (identity : ℕ) (p : Pool n) (d : LocalData p)
    (children : List (ℕ × StoredTree n)) (h : Parts p (StoredTree.erasedChildren children))
    (v : Fin n) (hv : p.pins v = none) (c : Fin (p.palette + 1))
    (r : Promotion.Result p.system p.pins v c)
    (e : LocalData (p.installPromotion v hv c r)) (fresh : ℕ)
    (root : LocalEvolution (ofData p d) (ofData (p.installPromotion v hv c r) e)) :
    Evolves (.node identity p d children) (StoredTree.promotedNode identity p children h v hv c r e fresh) := by
  unfold StoredTree.promotedNode
  dsimp only
  split
  · exact Evolves.node identity p _ d e children _ root (evolves_promotedChildren h v hv c r)
  · apply Evolves.node identity p _ d e children _ root
    intro a ha
    obtain ⟨b, hb, he⟩ := evolves_promotedChildren h v hv c r a ha
    exact ⟨b, List.mem_append_left _ hb, he⟩

theorem replayStep_evolves (identity : ℕ) {s t : State n} (step : Step s t)
    (children : List (ℕ × StoredTree n))
    (hw : (StoredRepair.node identity s children).erase.WellFormed)
    (ho : (StoredRepair.node identity s children).erase.Coherent) (counter : ℕ) :
    Evolves (StoredRepair.node identity s children)
      (StoredRepair.node identity t (StoredRepair.replayStep identity step children hw ho counter).children) := by
  cases step with
  | pin update =>
    have hp := parts (by simpa only [StoredRepair.erase_node] using hw)
    rw [replayStep_pin_shape identity update children hw ho counter hp]
    exact Evolves.promotedNode identity s.pool ⟨s.rows, s.order⟩ children hp update.vertex update.free
      update.colour update.result ⟨update.data.rows, update.data.order⟩ counter (.step (.pin update))
  | lowerCut u v live ratio charge retained =>
    exact Evolves.poolUpdate identity s.pool _ ⟨s.rows, s.order⟩ _ children
      (.step (.lowerCut s u v live ratio charge retained))
  | upperCut u v live ratio charge retained =>
    exact Evolves.poolUpdate identity s.pool _ ⟨s.rows, s.order⟩ _ children
      (.step (.upperCut s u v live ratio charge retained))

theorem replayTrace_evolves (identity : ℕ) {s t : State n} (trace : Trace s t)
    (children : List (ℕ × StoredTree n))
    (hw : (StoredRepair.node identity s children).erase.WellFormed)
    (ho : (StoredRepair.node identity s children).erase.Coherent) (counter : ℕ) :
    Evolves (StoredRepair.node identity s children)
      (StoredRepair.node identity t (StoredRepair.replayTrace identity trace children hw ho counter).children) := by
  induction trace generalizing children counter with
  | nil => exact Evolves.refl _
  | cons head tail ih =>
    let first := StoredRepair.replayStep identity head children hw ho counter
    exact (replayStep_evolves identity head children hw ho counter).trans
      (ih first.children first.wellFormed first.coherent first.counter)

theorem Evolves.stopNode (identity : ℕ) (p : Pool n) (d : LocalData p)
    (children : List (ℕ × StoredTree n)) (a b : Fin n)
    (ha : a ∈ p.members) (hb : b ∈ p.members) (hne : a ≠ b)
    (hi : ControllerRouting.Invariant (Safety.closedAdd p.system a b) p.pins) :
    Evolves (.node identity p d children) (StoredRouting.stopNode identity p d children a b ha hb hne hi) :=
  Evolves.poolUpdate identity p _ d _ children (.comparison p d a b ha hb hne hi)

theorem Evolves.delegatedNode (identity : ℕ) (p : Pool n) (d : LocalData p)
    (children : List (ℕ × StoredTree n)) (h : Parts p (StoredTree.erasedChildren children))
    (target : ℕ × StoredTree n) (ht : target ∈ children)
    (a b : Fin n) (ha : a ∈ target.2.pool.members) (hb : b ∈ target.2.pool.members)
    (hba : p.system.edge b a ≠ true) (next : StoredTree n) (history : Evolves target.2 next) :
    Evolves (.node identity p d children)
      (StoredRouting.delegatedNode identity p d children h target ht a b ha hb hba next) := by
  unfold StoredRouting.delegatedNode
  apply Evolves.node identity p _ d _ children _ (.comparison p d a b _ _ _ _)
  have hk : (children.map Prod.fst).Nodup := by
    simpa only [StoredTree.erasedChildren, List.map_map, Function.comp_def] using h.keys
  intro child hchild
  by_cases he : child.1 = target.1
  · have hc : child = target := List.inj_on_of_nodup_map hk hchild ht he
    subst child
    refine ⟨(target.1, next), ?_, history⟩
    exact List.mem_map.mpr ⟨target, ht, by simp⟩
  · refine ⟨child, ?_, Evolves.refl child.2⟩
    exact List.mem_map.mpr ⟨child, hchild, by simp [he]⟩

end SortingAdversary.Optimal.StoredEvolution
