import SortingAdversary.Optimal.Accounting

/-!
# Prefix and asymptotic consequences for the concrete machine

The first theorem applies the actual-volume accounting to a rational action
execution. The remaining reductions connect legal online prefixes to correct
sorting trees, handle the fixed finite horizon, and convert the manuscript's
vanishing overhead into the repository's leading-one online specification.
-/

namespace SortingAdversary.Continuous

open FiniteAveraging OrderRegion TreeState MeasureTheory Filter
open scoped Topology

variable {n : ℕ}

@[simp] theorem compatible_reverse (π : Ranking n) (h : History n) :
    Compatible π h.reverse ↔ Compatible π h := by
  simp only [Compatible, List.forall_iff_forall_mem, List.mem_reverse]

@[simp] theorem transcriptCount_reverse (h : History n) : transcriptCount h.reverse = transcriptCount h := by
  classical
  simp [transcriptCount, compatibleOrders]

/-- Reverse chronological histories generated by the actual strategy. -/
inductive Follows (strategy : Strategy n) : History n → Prop
  | nil : Follows strategy []
  | cons {h : History n} (q : Query n) (past : Follows strategy h) :
      Follows strategy (⟨q, strategy h q⟩ :: h)

theorem run_follows (strategy : Strategy n) (t : DecisionTree n) (past : History n)
    (hpast : Follows strategy past) :
    Follows strategy ((t.run strategy past).observations.reverse ++ past) := by
  induction t generalizing past with
  | leaf output => exact hpast
  | compare q onLess onGreater ihLess ihGreater =>
    have hn := Follows.cons q hpast
    cases ha : strategy past q with
    | less =>
      rw [ha] at hn
      simpa only [DecisionTree.run, ha, List.reverse_cons, List.append_assoc,
        List.singleton_append] using ihLess _ hn
    | greater =>
      rw [ha] at hn
      simpa only [DecisionTree.run, ha, List.reverse_cons, List.append_assoc,
        List.singleton_append] using ihGreater _ hn

theorem transcriptCount_run_eq_one (strategy : Strategy n) (t : DecisionTree n)
    (ht : t.Correct) (hlegal : ∃ π : Ranking n, Compatible π (t.run strategy []).observations) :
    transcriptCount (t.run strategy []).observations = 1 := by
  have hle : transcriptCount (t.run strategy []).observations ≤ 1 := by
    apply Finset.card_le_one.mpr
    intro π hπ σ hσ
    have hp := (t.run_matches_compatible_ranking strategy [] π
      ((mem_compatibleOrders _ _).mp hπ)).1
    have hs := (t.run_matches_compatible_ranking strategy [] σ
      ((mem_compatibleOrders _ _).mp hσ)).1
    rw [ht π] at hp
    rw [ht σ] at hs
    exact hp.trans hs.symm
  obtain ⟨π, hπ⟩ := hlegal
  have hpos := transcriptCount_pos _ π hπ
  omega

theorem sorting_bound_of_prefix (strategy : Strategy n) (t : DecisionTree n)
    (ht : t.Correct) (δ : ℝ)
    (hlegal : ∃ π : Ranking n, Compatible π (t.run strategy []).observations)
    (hprefix : ∀ h, Follows strategy h →
      log2 (n.factorial : ℝ) - (1 + δ) * h.length ≤ log2 (transcriptCount h : ℝ)) :
    log2 (n.factorial : ℝ) ≤ (1 + δ) * (t.run strategy []).comparisons := by
  have hf := run_follows strategy t [] Follows.nil
  simp only [List.append_nil] at hf
  have hb := hprefix _ hf
  rw [transcriptCount_reverse, transcriptCount_run_eq_one strategy t ht hlegal] at hb
  simp only [Nat.cast_one, log2_one, List.length_reverse, t.run_observations_length] at hb
  linarith

theorem log_factorial_lower (n : ℕ) :
    nLog2n n - n / Real.log 2 ≤ log2 (n.factorial : ℝ) := by
  have h := div_le_div_of_nonneg_right
    (SortingAdversary.Optimal.Accounting.log_factorial_lower_bound n) log_two_pos.le
  simpa only [sub_div, mul_div_assoc, nLog2n, log2] using h

theorem linear_remainder_tendsto :
    Tendsto (fun n : ℕ => (n / Real.log 2) / nLog2n n) atTop (𝓝 0) := by
  have hl : Tendsto (fun n : ℕ => Real.log n) atTop atTop :=
    Real.tendsto_log_atTop.comp tendsto_natCast_atTop_atTop
  have hi : Tendsto (fun n : ℕ => 1 / Real.log n) atTop (𝓝 0) :=
    tendsto_const_nhds.div_atTop hl
  apply hi.congr' (eventually_atTop.mpr ⟨2, fun n hn => ?_⟩)
  have hnR : (1 : ℝ) < n := by exact_mod_cast (show 1 < n by omega)
  unfold nLog2n
  field_simp [ne_of_gt (lt_trans zero_lt_one hnR), ne_of_gt (Real.log_pos hnR),
    ne_of_gt log_two_pos]

/-- A prefix estimate with vanishing overhead gives the exact existing
online asymptotic specification, through the actual sorting-tree semantics. -/
theorem asymptoticallyOptimal_of_prefix
    (strategy : ∀ n, Strategy n) (δ : ℕ → ℝ)
    (hlegal : SortingAdversary.Optimal.ConsistentFamily strategy)
    (hprefix : ∀ n h, Follows (strategy n) h →
      log2 (n.factorial : ℝ) - (1 + δ n) * h.length ≤ log2 (transcriptCount h : ℝ))
    (hδ : Tendsto δ atTop (𝓝 0)) : SortingAdversary.Optimal.AsymptoticallyOptimal strategy := by
  apply SortingAdversary.Optimal.comparison_guarantee_of_vanishing_accounting
    strategy δ (fun n => n / Real.log 2) hlegal ?_ hδ linear_remainder_tendsto
  intro n hn t ht
  have hb := sorting_bound_of_prefix (strategy n) t ht (δ n) (hlegal n t) (hprefix n)
  have hf := log_factorial_lower n
  linarith

namespace Controller

theorem valid_append {k : ℕ} (F : TraceAccounting.Frame n)
    (as bs : List (TraceAccounting.Action n))
    (ha : TraceAccounting.Valid k F as)
    (hb : TraceAccounting.Valid k (TraceAccounting.run F as) bs) :
    TraceAccounting.Valid k F (as ++ bs) := by
  induction as generalizing F with
  | nil => exact hb
  | cons a as ih => exact ⟨ha.1, ih (TraceAccounting.execute F a) ha.2 hb⟩

/-- Reachability by the actual action evaluator, with only the local
numeric guarantees at the intermediate states. -/
def Traced (k : ℕ) (M : Memory n) : Prop :=
  ∃ actions : List (TraceAccounting.Action n), runActions (initial n) actions = M ∧
    TraceAccounting.Valid k (TraceAccounting.initialFrame n) actions

theorem initial_traced (k n : ℕ) : Traced k (initial n) := ⟨[], rfl, trivial⟩

theorem Traced.compare {k : ℕ} {M : Memory n} (hM : Traced k M)
    (q : Query n) (r : Result n) (h : compare k M q = some r)
    (hv : ∀ F, M.Represents F → TraceAccounting.Valid k F r.actions) : Traced k r.memory := by
  obtain ⟨actions, hactions, hvalid⟩ := hM
  refine ⟨actions ++ r.actions, ?_, ?_⟩
  · rw [runActions_append, hactions]
    exact (compare_memory k M q r h).symm
  · apply valid_append _ _ _ hvalid
    apply hv
    rw [← hactions]
    exact runActions_represents (initial n) (TraceAccounting.initialFrame n)
      ⟨initial_toReal n, rfl, rfl⟩ actions

/-- The runtime's rational state is exactly the state counted by the
geometric evaluator. No ledger identities are hypotheses of this theorem. -/
theorem memory_prefix {k : ℕ} (hk : 64 ≤ k) (actions : List (TraceAccounting.Action n))
    (hvalid : TraceAccounting.Valid k (TraceAccounting.initialFrame n) actions)
    (hgeo : Geometric (runActions (initial n) actions))
    (hsupport : (runActions (initial n) actions).Supported) :
    log2 (n.factorial : ℝ) - (1 + prefixOverhead k) *
      (runActions (initial n) actions).history.length ≤
      log2 (transcriptCount (runActions (initial n) actions).history : ℝ) := by
  have hr := runActions_represents (initial n) (TraceAccounting.initialFrame n)
    (by exact ⟨initial_toReal n, rfl, rfl⟩) actions
  obtain ⟨ht, hp, hh⟩ := hr
  have hs : (TraceAccounting.run (TraceAccounting.initialFrame n) actions).state.Consistent
      (TraceAccounting.run (TraceAccounting.initialFrame n) actions).history := by
    rw [← ht, ← hh]
    exact hgeo.consistent
  have hb : ∀ x, 0 ≤ (TraceAccounting.run (TraceAccounting.initialFrame n) actions).state.system.lower x ∧
      (TraceAccounting.run (TraceAccounting.initialFrame n) actions).state.system.upper x ≤ 1 := by
    rw [← ht]
    exact hgeo.bounds
  have hu : ∀ x ∉ queriedLabels (TraceAccounting.run (TraceAccounting.initialFrame n) actions).history,
      IsolatedUnit (TraceAccounting.run (TraceAccounting.initialFrame n) actions).state.system x := by
    rw [← hh, ← ht]
    exact fun x hx => (hsupport x hx).1
  have he : ∀ x ∉ queriedLabels (TraceAccounting.run (TraceAccounting.initialFrame n) actions).history,
      (TraceAccounting.run (TraceAccounting.initialFrame n) actions).paths x = [] := by
    rw [← hh, ← hp]
    exact fun x hx => (hsupport x hx).2
  have hV : 0 < nodeVolume (TraceAccounting.run (TraceAccounting.initialFrame n) actions).state.system := by
    rw [← ht]
    exact nodeVolume_pos _ hgeo.positive
  have h := TraceAccounting.run_initial_prefix hk actions hvalid hs hb hu he hV
  rwa [← hh] at h

theorem Traced.prefix {k : ℕ} (hk : 64 ≤ k) {M : Memory n} (hM : Traced k M)
    (hgeo : Geometric M) (hsupport : M.Supported) :
    log2 (n.factorial : ℝ) - (1 + prefixOverhead k) * M.history.length ≤
      log2 (transcriptCount M.history : ℝ) := by
  obtain ⟨actions, rfl, hvalid⟩ := hM
  exact memory_prefix hk actions hvalid hgeo hsupport

theorem log_factorial_le_horizon (n : ℕ) : log2 (n.factorial : ℝ) ≤ horizon n := by
  by_cases hn : n = 0
  · simp [hn, horizon]
  have hp : (0 : ℝ) < n := by exact_mod_cast Nat.pos_of_ne_zero hn
  have hf := log2_mono (show (0 : ℝ) < n.factorial by positivity)
    (show (n.factorial : ℝ) ≤ (n : ℝ) ^ n by exact_mod_cast Nat.factorial_le_pow n)
  have hc := log2_mono hp
    (show (n : ℝ) ≤ (2 : ℝ) ^ Nat.clog 2 n by exact_mod_cast Nat.le_pow_clog (by decide) n)
  rw [log2_pow, log2_two, mul_one] at hc
  rw [log2_pow] at hf
  exact hf.trans (by simpa only [horizon, Nat.cast_mul] using
    mul_le_mul_of_nonneg_left hc hp.le)

/-- Once the fixed horizon is reached, legality alone supplies every later
prefix estimate. Its left side is already nonpositive. -/
theorem prefix_after_horizon {k : ℕ} (hk : 64 ≤ k) (h : History n)
    (hlegal : ∃ π : Ranking n, Compatible π h) (hh : horizon n ≤ h.length) :
    log2 (n.factorial : ℝ) - (1 + prefixOverhead k) * h.length ≤
      log2 (transcriptCount h : ℝ) := by
  obtain ⟨π, hπ⟩ := hlegal
  have hpos := transcriptCount_pos h π hπ
  have hlog : 0 ≤ log2 (transcriptCount h : ℝ) :=
    log2_nonneg (by exact_mod_cast hpos)
  have hkR : (64 : ℝ) ≤ k := by exact_mod_cast hk
  have hδ := prefixOverhead_nonneg hkR
  have hclock : (horizon n : ℝ) ≤ h.length := by exact_mod_cast hh
  have hf := log_factorial_le_horizon n
  have hnonneg : (0 : ℝ) ≤ h.length := Nat.cast_nonneg _
  nlinarith

/-- The local theorem expected from the executable controller. All mutation
and accounting conclusions are about the returned concrete action list. -/
def CompareGuarantee (n k : ℕ) : Prop :=
  ∀ M : Memory n, Ready k M → ∀ q : Query n, ∃ r : Result n,
    compare k M q = some r ∧ Ready k r.memory ∧
      ∀ F, M.Represents F → TraceAccounting.Valid k F r.actions

def ActiveInvariant (k : ℕ) (M : Memory n) : Prop :=
  Ready k M ∧ M.Supported ∧ Traced k M

theorem initial_activeInvariant {k : ℕ} (hk : 64 ≤ k) : ActiveInvariant k (initial n) :=
  ⟨initial_ready n k (by omega), initial_supported n, initial_traced k n⟩

theorem ActiveInvariant.compatible {k : ℕ} {M : Memory n} (hM : ActiveInvariant k M) :
    ∃ π : Ranking n, Compatible π M.history :=
  M.tree.toReal.exists_compatible M.history hM.1.consistent hM.1.bounds hM.1.positive

theorem ActiveInvariant.prefix {k : ℕ} (hk : 64 ≤ k) {M : Memory n}
    (hM : ActiveInvariant k M) :
    log2 (n.factorial : ℝ) - (1 + prefixOverhead k) * M.history.length ≤
      log2 (transcriptCount M.history : ℝ) :=
  hM.2.2.prefix hk hM.1.toGeometric hM.2.1

theorem activeInvariant_compare {k : ℕ} (hk : 64 ≤ k) (hcompare : CompareGuarantee n k)
    (M : Memory n) (hM : ActiveInvariant k M) (q : Query n) :
    ∃ r, compare k M q = some r ∧ ActiveInvariant k r.memory := by
  obtain ⟨r, hr, hready, hvalid⟩ := hcompare M hM.1 q
  exact ⟨r, hr, hready,
    compare_supported k (by omega) M hM.2.1 q r hr, hM.2.2.compare q r hr hvalid⟩

private theorem compare_preserves {k : ℕ} (hk : 64 ≤ k) (hcompare : CompareGuarantee n k) :
    ∀ M, ActiveInvariant k M → ∀ q r, compare k M q = some r →
      ActiveInvariant k r.memory ∧ ∃ π : Ranking n, Compatible π r.memory.history := by
  intro M hM q r hr
  obtain ⟨r', hr', hR⟩ := activeInvariant_compare hk hcompare M hM q
  have he : r' = r := Option.some.inj (hr'.symm.trans hr)
  subst r'
  exact ⟨hR, hR.compatible⟩

/-- In the frozen phase, the physical comparison count has already reached
the declared horizon. Exhaustion cannot be the reason for freezing because
the local comparison guarantee supplies a successful result. -/
def PrefixSound (k : ℕ) (s : MachineState n) (h : History n) : Prop :=
  Sound (ActiveInvariant k) s h ∧
    match s with
    | .active _ => True
    | .frozen _ => horizon n ≤ h.length

theorem initial_prefixSound {k : ℕ} (hk : 64 ≤ k) : PrefixSound k (start n k) [] := by
  refine ⟨initial_sound _ k (initial_activeInvariant hk), ?_⟩
  simp [start, hk]

theorem step_prefixSound {k : ℕ} (hk : 64 ≤ k) (hcompare : CompareGuarantee n k)
    (s : MachineState n) (h : History n) (hs : PrefixSound k s h) (q : Query n) :
    PrefixSound k (step k s q).2 (⟨q, (step k s q).1⟩ :: h) := by
  refine ⟨step_sound _ k (compare_preserves hk hcompare) s h hs.1 q, ?_⟩
  cases s with
  | frozen ranks =>
    change horizon n ≤ (⟨q, rankAnswer ranks q⟩ :: h).length
    have hh := hs.2
    simp only [List.length_cons]
    omega
  | active M =>
    have hM : ActiveInvariant k M := hs.1.1
    have hhist : M.history = h := hs.1.2.1
    by_cases htime : M.history.length < horizon n
    · obtain ⟨r, hr, _⟩ := activeInvariant_compare hk hcompare M hM q
      simp [step, htime, hr]
    · simp only [step, if_neg htime, List.length_cons]
      rw [hhist] at htime
      omega

theorem follows_prefixSound {k : ℕ} (hk : 64 ≤ k) (hcompare : CompareGuarantee n k)
    (h : History n) (hf : Follows (strategy k) h) : PrefixSound k (replay k h) h := by
  induction hf with
  | nil => exact initial_prefixSound hk
  | @cons h q hf ih =>
    simpa only [replay_cons, strategy] using step_prefixSound hk hcompare (replay k h) h ih q

/-- Every finite legal interaction prefix, including prefixes in the frozen
phase, satisfies the paper's target-independent transcript inequality. -/
theorem prefix_of_compare_guarantee {k : ℕ} (hk : 64 ≤ k) (hcompare : CompareGuarantee n k)
    (h : History n) (hf : Follows (strategy k) h) :
    log2 (n.factorial : ℝ) - (1 + prefixOverhead k) * h.length ≤
      log2 (transcriptCount h : ℝ) := by
  have hs := follows_prefixSound hk hcompare h hf
  cases hr : replay k h with
  | active M =>
    rw [hr] at hs
    have hp := hs.1.1.prefix hk
    rwa [hs.1.2.1] at hp
  | frozen ranks =>
    rw [hr] at hs
    exact prefix_after_horizon hk h hs.1.compatible hs.2

theorem consistent_of_compare_guarantee {k : ℕ} (hk : 64 ≤ k)
    (hcompare : CompareGuarantee n k) (t : DecisionTree n) :
    ∃ π : Ranking n, Compatible π (t.run (strategy k) []).observations :=
  strategy_consistent_of_memory_invariant (ActiveInvariant k) k
    (initial_activeInvariant hk) (compare_preserves hk hcompare) t

/-- Instantiating the local executable comparison theorem at any divergent
parameter schedule gives the online leading-one theorem for that machine. -/
theorem asymptoticallyOptimal_of_compare_guarantee (stage : ℕ → ℕ)
    (hk : ∀ n, 64 ≤ stage n) (hstage : Tendsto stage atTop atTop)
    (hcompare : ∀ n, CompareGuarantee n (stage n)) :
    SortingAdversary.Optimal.AsymptoticallyOptimal (fun n => strategy (stage n)) := by
  apply asymptoticallyOptimal_of_prefix (fun n => strategy (stage n))
    (fun n => prefixOverhead (stage n))
  · exact fun n t => consistent_of_compare_guarantee (hk n) (hcompare n) t
  · exact fun n h hf => prefix_of_compare_guarantee (hk n) (hcompare n) h hf
  · exact selected_overhead_tendsto stage hstage

